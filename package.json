{
	"name": "tane",
	"version": "0.0.1",
	"description": "Tane: personal finance in your Obsidian vault. One transaction per note.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"check": "npm run build && npm run lint && npm test && node scripts/check-forbidden.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"typecheck": "tsc -noEmit -skipLibCheck && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
	},
	"keywords": [
		"obsidian",
		"finance",
		"budget"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "^0.28.2",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.12.0",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.1.1"
	}
}
